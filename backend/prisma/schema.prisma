generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PREPOSITION
  CONJUNCTION
  PRONOUN
  INTERJECTION
  PHRASE
  OTHER
}

enum ChatRole {
  USER
  ASSISTANT
}

model User {
  id             Int              @id @default(autoincrement())
  email          String           @unique
  password       String
  name           String
  avatar         String?
  dailyGoal      Int              @default(10)
  level          Difficulty       @default(BEGINNER)
  goalType       String?
  selfLevel      String?
  onboarded      Boolean          @default(false)
  streak         Int              @default(0)
  longestStreak  Int              @default(0)
  xp             Int              @default(0)
  reminderHour   Int?
  lastStudyAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  decks          Deck[]
  progress       Progress[]
  quizAttempts   QuizAttempt[]
  studyLogs      StudyLog[]
  chatMessages   ChatMessage[]
  lessonProgress LessonProgress[]
  notifications  Notification[]
  friendCode             String?      @unique
  hideFromLeaderboard    Boolean      @default(false)
  sentFriendRequests     Friendship[] @relation("FriendRequester")
  receivedFriendRequests Friendship[] @relation("FriendAddressee")
  badges                 UserBadge[]
  pushTokens     PushToken[]
}

model Deck {
  id           Int           @id @default(autoincrement())
  title        String
  description  String?
  topic        String?
  emoji        String?
  difficulty   Difficulty    @default(BEGINNER)
  isPublic     Boolean       @default(false)
  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      Int?
  words        Word[]
  quizAttempts QuizAttempt[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([ownerId])
  @@index([topic])
}

model Unit {
  id      Int        @id @default(autoincrement())
  level   Difficulty
  order   Int
  title   String
  titleVi String
  emoji   String?
  lessons Lesson[]

  @@unique([level, order])
}

model Lesson {
  id        Int              @id @default(autoincrement())
  unit      Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId    Int
  order     Int
  title     String
  words     Word[]
  type      LessonType       @default(VOCAB)
  noteMd    String?
  exercises Exercise[]
  progress  LessonProgress[]

  @@unique([unitId, order])
}

model LessonProgress {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    Int
  stars       Int       @default(0)
  bestScore   Int       @default(0)
  attempts    Int       @default(0)
  completedAt DateTime?

  @@unique([userId, lessonId])
}

model Word {
  id             Int          @id @default(autoincrement())
  term           String
  meaning        String
  phonetic       String?
  partOfSpeech   PartOfSpeech @default(OTHER)
  example        String?
  exampleMeaning String?
  exampleSource  String?
  synonym        String?
  imageUrl       String?
  deck           Deck?        @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId         Int?
  lesson         Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId       Int?
  progress       Progress[]
  createdAt      DateTime     @default(now())

  @@index([deckId])
  @@index([lessonId])
}

model Progress {
  id             Int       @id @default(autoincrement())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  word           Word      @relation(fields: [wordId], references: [id], onDelete: Cascade)
  wordId         Int
  level          Int       @default(0)
  correctCount   Int       @default(0)
  wrongCount     Int       @default(0)
  isFavorite     Boolean   @default(false)
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?

  @@unique([userId, wordId])
  @@index([userId, nextReviewAt])
  @@index([userId, isFavorite])
}

model QuizAttempt {
  id             Int      @id @default(autoincrement())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  deck           Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId         Int
  totalQuestions Int
  correctAnswers Int
  durationSec    Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model StudyLog {
  id           Int      @id @default(autoincrement())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  date         DateTime @db.Date
  wordsLearned Int      @default(0)
  wordsReview  Int      @default(0)
  minutes      Int      @default(0)
  xp           Int      @default(0)

  @@unique([userId, date])
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

enum NotificationType {
  STREAK_MILESTONE
  STREAK_LOST
  DAILY_GOAL_DONE
  REVIEW_DUE
  SYSTEM
}

model Notification {
  id        Int              @id @default(autoincrement())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PushToken {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum LessonType {
  VOCAB
  GRAMMAR
  CHECKPOINT
  VIDEO
}

model Exercise {
  id            Int     @id @default(autoincrement())
  lesson        Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId      Int
  order         Int
  type          String
  payload       Json
  explanationVi String?
  mediaUrl      String?

  @@unique([lessonId, order])
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id          Int          @id @default(autoincrement())
  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId Int
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  addresseeId Int
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model UserBadge {
  id       Int      @id @default(autoincrement())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  badgeKey String
  earnedAt DateTime @default(now())

  @@unique([userId, badgeKey])
}
